# Application
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/ai_assistant

# External APIs
CATALOG_API_BASE_URL=https://venus-api-catalog2.apps-web.net
CITIES_API_BASE_URL=https://venus-api-backend2.apps-web.net
CATALOG_API_MODE=mock

# LLM Provider (AITunnel via OpenAI-compatible API)
# https://docs.aitunnel.ru/guides/python-openai-sdk.html
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.aitunnel.ru/v1/
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1500

# Embedding Provider
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Assistant Config
DEFAULT_RN=A79C5050-1EE7-11EB-9B6E-05B5FC40DF2A
MAX_CANDIDATES_FOR_LLM=30
MAX_CARDS_IN_RESPONSE=5
LLM_TIMEOUT_MS=6000
SESSION_TTL_MINUTES=60

# Suggestions
MAX_SUGGESTIONS_ON_SCREEN=8
HIDE_EMPTY_SUGGESTIONS=true

# Internal API Security
INTERNAL_API_KEY=dev-internal-key-change-in-prod

# Admin Panel (AdminJS at /admin)
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_COOKIE_SECRET=replace-with-at-least-32-char-random-secret-here
