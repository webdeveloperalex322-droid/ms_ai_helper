# Application
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/ai_assistant

# External APIs
CATALOG_API_BASE_URL=https://venus-api-catalog2.apps-web.net
CITIES_API_BASE_URL=https://venus-api-backend2.apps-web.net
CATALOG_API_MODE=mock

# LLM Provider (AITunnel via OpenAI-compatible API)
# https://docs.aitunnel.ru/guides/python-openai-sdk.html
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.aitunnel.ru/v1/
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1500

# Embedding Provider
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Assistant Config
DEFAULT_RN=A79C5050-1EE7-11EB-9B6E-05B5FC40DF2A
MAX_CANDIDATES_FOR_LLM=30
MAX_CARDS_IN_RESPONSE=5
LLM_TIMEOUT_MS=6000
SESSION_TTL_MINUTES=60

# Suggestions
MAX_SUGGESTIONS_ON_SCREEN=8
HIDE_EMPTY_SUGGESTIONS=true

# Access control (spec 007/008). These placeholders work in development only —
# NODE_ENV=production refuses to start on any of them (unset, matching one of
# these exact values, or shorter than the required minimum). Generate real
# random values before deploying; see docs/knowledge/decisions.md.
#
# Internal API key — required by every /internal/* endpoint (import, admin
# config). Machine-generated, min 32 chars in production.
INTERNAL_API_KEY=dev-internal-key-change-in-prod
# Client access keys — comma-separated "label:key" pairs, one per consumer
# (e.g. the web widget, a partner integration). Each key needs its own unique
# label and value; min 32 chars per key in production.
CLIENT_API_KEYS=dev-client:dev-client-key-change-in-prod
# "observe" logs unauthenticated client requests instead of rejecting them —
# use only for a staged rollout, never leave it on in a live deployment.
ACCESS_CONTROL_MODE=enforce
# Set true only when the app sits behind a reverse proxy (nginx) that sets
# X-Forwarded-For — otherwise every client looks like it shares the proxy's IP.
# True means "trust exactly one hop" (see main.ts), so the app reads the address
# that hop observed rather than anything a client wrote into the header. Enable
# it only when a proxy really is in front: with no proxy, a direct caller could
# set X-Forwarded-For itself and pick its own rate-limit bucket.
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576

# Rate limiting — tune against real traffic after rollout.
THROTTLE_COSTLY_LIMIT=10
THROTTLE_COSTLY_TTL_SEC=60
THROTTLE_STANDARD_LIMIT=60
THROTTLE_STANDARD_TTL_SEC=60

# Browser CORS — comma-separated list of allowed origins (e.g.
# https://shop.example.com,https://partner.example.com). Empty is fine in
# development (every origin is allowed); production refuses to start with an
# empty list here.
CORS_ALLOWED_ORIGINS=

# Admin Panel (AdminJS at /admin)
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_COOKIE_SECRET=replace-with-at-least-32-char-random-secret-here
