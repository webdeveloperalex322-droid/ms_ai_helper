{
  "name": "ai-product-assistant",
  "version": "0.1.0",
  "description": "AI Product Assistant backend — MVP",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf"
    ],
    "overrides": {
      "@tiptap/core": "2.1.13",
      "@tiptap/pm": "2.1.13",
      "@tiptap/react": "2.1.13",
      "@tiptap/starter-kit": "2.1.13",
      "@tiptap/extension-blockquote": "2.1.13",
      "@tiptap/extension-bold": "2.1.13",
      "@tiptap/extension-bubble-menu": "2.1.13",
      "@tiptap/extension-bullet-list": "2.1.13",
      "@tiptap/extension-character-count": "2.1.13",
      "@tiptap/extension-code": "2.1.13",
      "@tiptap/extension-code-block": "2.1.13",
      "@tiptap/extension-document": "2.1.13",
      "@tiptap/extension-dropcursor": "2.1.13",
      "@tiptap/extension-floating-menu": "2.1.13",
      "@tiptap/extension-gapcursor": "2.1.13",
      "@tiptap/extension-hard-break": "2.1.13",
      "@tiptap/extension-heading": "2.1.13",
      "@tiptap/extension-history": "2.1.13",
      "@tiptap/extension-horizontal-rule": "2.1.13",
      "@tiptap/extension-image": "2.1.13",
      "@tiptap/extension-italic": "2.1.13",
      "@tiptap/extension-link": "2.1.13",
      "@tiptap/extension-list-item": "2.1.13",
      "@tiptap/extension-mention": "2.1.13",
      "@tiptap/extension-ordered-list": "2.1.13",
      "@tiptap/extension-paragraph": "2.1.13",
      "@tiptap/extension-strike": "2.1.13",
      "@tiptap/extension-table": "2.1.13",
      "@tiptap/extension-table-cell": "2.1.13",
      "@tiptap/extension-table-header": "2.1.13",
      "@tiptap/extension-table-row": "2.1.13",
      "@tiptap/extension-text": "2.1.13",
      "@tiptap/extension-text-align": "2.1.13",
      "@tiptap/extension-typography": "2.1.13",
      "@tiptap/extension-underline": "2.1.13"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test,seeds}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,seeds}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx seeds/index.ts",
    "rag:index": "tsx scripts/rag-index-product.ts",
    "rag:index-all": "tsx scripts/rag-index-all.ts",
    "db:studio": "drizzle-kit studio",
    "chat:prod": "node test-client/serve-prod.mjs"
  },
  "dependencies": {
    "@adminjs/fastify": "4.1.3",
    "@adminjs/nestjs": "^7.0.0",
    "@adminjs/sql": "^2.2.6",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^7.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.5.0",
    "adminjs": "^7.8.17",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.1.0",
    "knex": "^3.3.0",
    "openai": "^4.104.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
