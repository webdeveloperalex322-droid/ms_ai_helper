# Files that run on the Linux prod server must keep LF even on a Windows
# checkout with core.autocrlf=true: bash rejects CRLF scripts ("$'\r': command
# not found"), and deploys ship straight from the working tree / git archive.
*.sh          text eol=lf
Dockerfile    text eol=lf
*.conf        text eol=lf
*.sql         text eol=lf
docker-compose*.yml text eol=lf
